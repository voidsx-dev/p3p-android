<?xml version="1.0" encoding="utf-8"?>
<!-- Persona 3 Portable: a NativeActivity (the runtime in libp3p.so, android_main) behind a home screen with the options
     (games/p3p/java: Launcher.java, which writes config.txt). The game data from the player's own dump (exefs/,
     extract/romfs/, spirv/: games/p3p/tools/prepare_data.ps1) lives in Internal storage/Persona 3 Portable, which needs
     all-files access. The native build (NX_NCE, build_android.cmd -Nce) holds no game code: it runs exefs/ as it is.
     The recompiled build (analysis/ and the game's code compiled in) is private to the owner of the game. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.p3pandroid"
    android:versionCode="10"
    android:versionName="0.3.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Vulkan 1.1: the mid-range GPUs the port targets (Adreno 610, PowerVR BXM) have nothing newer. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="P3P"
        android:requestLegacyExternalStorage="true"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:isGame="true"
        android:appCategory="game"
        android:largeHeap="true"
        android:theme="@style/Fullscreen">
        <!-- Home screen: data check, options (config.txt), then the game. -->
        <activity
            android:name=".Launcher"
            android:exported="true"
            android:theme="@style/Fullscreen"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- RomFS mod manager. -->
        <activity
            android:name=".ModManagerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="sensorLandscape" />
        <!-- Read-only device, memory, GPU and game-data diagnostics. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="sensorLandscape" />
        <!-- Prepares the game once: checks the player's NSP and keys and translates its shaders (libp3pimport.so with
             libspirvharness.so, the shader translator). Its own process, so the translator's runtime never shares
             the game's. -->
        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:process=":import"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <!-- Where the on-screen controls go (NX_TOUCH_LAYOUT), full screen like the game. -->
        <activity
            android:name=".ControlsEditor"
            android:exported="false"
            android:theme="@style/Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <!-- The game: a NativeActivity (GameActivity: asks before quitting on Back) in its own process, so that the
             runtime ending its process when the game closes leaves the launcher running. Exported: test runs start it
             directly (tools/push_android.ps1). -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="p3p" />
        </activity>
    </application>
</manifest>
